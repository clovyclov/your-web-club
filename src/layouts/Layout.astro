---
import '../styles/global.css';
import LeadFormModal from '../components/LeadFormModal.astro';

interface Props {
  title?: string;
  description?: string;
  includeLeadModal?: boolean;
}

const {
  title = "Your Web Club | Homeowner Lead Systems for Contractors",
  description = "Helping Contractors, Landscapers, and Remodelers Book High-Quality Homeowner Jobs with results-driven Google and Meta ads.",
  includeLeadModal = true,
} = Astro.props;
---

<!html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logos/ywc-logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yourwebclub.com" />
    <meta property="og:image" content="https://yourwebclub.com/logos/ywc-logo.png" />


    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-ND7S82G2');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-ND7S82G2"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    {includeLeadModal && <LeadFormModal />}
  </body>
</html>
