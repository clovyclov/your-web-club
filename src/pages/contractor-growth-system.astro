---
import Layout from '../layouts/Layout.astro';
import MetaHero from '../components/meta/MetaHero.astro';
import GuaranteeSection from '../components/meta/GuaranteeSection.astro';
import ComparisonTable from '../components/meta/ComparisonTable.astro';
import EngineBreakdown from '../components/meta/EngineBreakdown.astro';
import OnboardingTimelineSection from '../components/meta/OnboardingTimelineSection.astro';
import ValueStackSection from '../components/meta/ValueStackSection.astro';
import PricingJustificationSection from '../components/meta/PricingJustificationSection.astro';
import FormSection from '../components/FormSection.astro';
import ContractorFAQ from '../components/meta/ContractorFAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="The Contractor Growth System™ | 14-Day Money-Back Guarantee"
  description="Get a high-converting contractor website & automated SMS booking system for $297/mo. Try it for 14 days — if you're not satisfied, get a full refund, no questions asked."
>
  <main>
    <MetaHero />
    <GuaranteeSection />
    <ComparisonTable />
    <EngineBreakdown />
    <OnboardingTimelineSection />
    <ValueStackSection />
    <PricingJustificationSection />
    <div id="claim-offer">
      <FormSection />
    </div>
    <ContractorFAQ />
  </main>
  <Footer />
</Layout>
