<script>
  const WEBHOOK_URL = 'https://services.leadconnectorhq.com/hooks/TSqcO2Er7wAliwNMEQpv/webhook-trigger/899407be-efbe-4c5f-97c2-fd2cd9477633';

  const form = document.getElementById('assessmentForm') as HTMLFormElement | null;
  const formSuccess = document.getElementById('formSuccess');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Check honeypot
    const hp = (document.getElementById('hpSite') as HTMLInputElement)?.value;
    if (hp && hp.trim() !== '') {
      form.style.display = 'none';
      formSuccess?.classList.remove('hidden');
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Submitting Assessment Request...</span>';
    }

    const formData = new FormData(form);
    const payload = {
      form_name: 'The Local Client Engine - Growth Assessment',
      submitted_at: new Date().toISOString(),
      fullName: formData.get('fullName') || '',
      businessName: formData.get('businessName') || '',
      phone: formData.get('phone') || '',
      email: formData.get('email') || '',
      primaryTrade: formData.get('primaryTrade') || '',
      targetLocation: formData.get('targetLocation') || '',
      source_page: '/local-client-engine',
    };

    try {
      await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      form.style.display = 'none';
      formSuccess?.classList.remove('hidden');
    } catch (err) {
      console.error('Submission error:', err);
      alert('There was a slight connection issue submitting the form. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <span>GET MY CUSTOM GROWTH ASSESSMENT</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        `;
      }
    }
  });
</script>
