---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="The Local Client Engine™ | Done-For-You Lead-to-Booking System for Contractors"
  description="Stop waiting for referrals. We build and manage the complete local system that generates qualified local leads with Google LSA & Meta ads, responds in 5 seconds, and turns inquiries into booked estimates."
>
  <Header />

  <main class="lce-main">
    <!-- ================= 1. HERO SECTION ================= -->
    <section class="lce-hero">
      <div class="container hero-container flex-column align-center">
        <!-- Top Announcement Badge -->
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>THE LOCAL CLIENT ENGINE™ • DONE-FOR-YOU SYSTEM</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title">
          MORE QUALIFIED LOCAL LEADS. <span class="highlight">MORE BOOKED JOBS.</span> LESS GUESSWORK.
        </h1>

        <!-- Subheadline -->
        <p class="hero-subtitle">
          Stop waiting for referrals or fighting over shared leads on Angi. We build and manage the complete local system that gets your business discovered on Google LSA & Meta, responds in 5 seconds, and turns inquiries into booked estimates and paying jobs.
        </p>

        <!-- Hero Supporting Bullets -->
        <div class="hero-bullets">
          <div class="bullet-item">
            <div class="bullet-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Get in front of homeowners already searching for your exact high-ticket services.</span>
          </div>
          <div class="bullet-item">
            <div class="bullet-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Give every inquiry a 5-second professional response—even when you're on a job site.</span>
          </div>
          <div class="bullet-item">
            <div class="bullet-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>See every lead, booked estimate, and won job in real-time with full pipeline visibility.</span>
          </div>
        </div>

        <!-- Hero CTA & Subtext -->
        <div class="hero-cta-wrapper">
          <a href="#assessment" class="btn btn-neon btn-lg">REQUEST MY LOCAL GROWTH ASSESSMENT</a>
          <p class="cta-guarantee-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shield-mini">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Includes Territory Availability Check & Revenue Capacity Audit
          </p>
        </div>

        <!-- Trust Badges Bar -->
        <div class="trust-bar">
          <div class="trust-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Google LSA (Google Guaranteed)</span>
          </div>
          <div class="trust-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>5-Second Speed to Lead (GHL)</span>
          </div>
          <div class="trust-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100% Exclusive Inquiries</span>
          </div>
          <div class="trust-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Build & Launch Guarantee</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 2. THE OLD WAY VS NEW WAY ================= -->
    <section class="section comparison-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">THE SHIFT</span>
          <h2 class="section-title">STOP RUNNING ON "HOPE MARKETING"</h2>
          <p class="section-subtitle">
            Most local contractors either wait for word-of-mouth or waste thousands on shared lead platforms where 5 other guys race to quote the bottom dollar.
          </p>
        </div>

        <div class="comparison-grid">
          <!-- The Old Way -->
          <div class="comp-card old-way">
            <div class="comp-header">
              <div class="comp-badge bad">THE OLD FRUSTRATING WAY</div>
              <h3>"Hoping the Phone Rings"</h3>
            </div>
            <ul class="comp-list">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                <span><strong>Unpredictable Schedules:</strong> Rollercoaster revenue swings depending on seasonal referrals.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                <span><strong>Recycled Shared Leads:</strong> Paying Angi or Thumbtack for tire-kickers who got blasted to 6 competitors.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                <span><strong>Missed Calls On-Site:</strong> Leads call while you're driving or operating machinery and book with the next guy.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                <span><strong>Zero Visibility:</strong> No idea what your marketing produces, what leads closed, or where money went.</span>
              </li>
            </ul>
          </div>

          <!-- The New Way -->
          <div class="comp-card new-way">
            <div class="comp-header">
              <div class="comp-badge good">THE LOCAL CLIENT ENGINE™</div>
              <h3>A Predictable Booking Machine</h3>
            </div>
            <ul class="comp-list">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span><strong>Top of Google & Meta:</strong> Prime placement on Google Local Services (Google Guaranteed) & Meta.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span><strong>100% Exclusive Opportunities:</strong> Every caller and quote request belongs to your business alone.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span><strong>5-Second Speed to Lead:</strong> Automated SMS responder qualifies homeowners and locks in estimates instantly.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span><strong>Complete Pipeline Control:</strong> Simple GHL dashboard tracks leads, booked jobs, and exact ROI in plain English.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 3. THE 4 OUTCOMES YOU ARE ACTUALLY BUYING ================= -->
    <section class="section outcomes-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">WHAT YOU ARE ACTUALLY BUYING</span>
          <h2 class="section-title">THE 4 PILLARS OF CONTRACTOR CONTROL</h2>
          <p class="section-subtitle">
            We don't sell disconnected software or technical tasks. We build an accountable business asset that delivers 4 critical outcomes.
          </p>
        </div>

        <div class="outcomes-grid">
          <!-- Outcome 1 -->
          <div class="outcome-card">
            <div class="outcome-num">01</div>
            <div class="outcome-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 class="outcome-title">VISIBILITY</h3>
            <p class="outcome-text">
              More of the right local homeowners see your business the exact moment they need urgent repairs, major remodels, or high-ticket installations.
            </p>
          </div>

          <!-- Outcome 2 -->
          <div class="outcome-card">
            <div class="outcome-num">02</div>
            <div class="outcome-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
            <h3 class="outcome-title">CONVERSION</h3>
            <p class="outcome-text">
              Inquiries land on a persuasive, high-trust local destination built specifically to trigger phone calls and estimate requests—not design awards.
            </p>
          </div>

          <!-- Outcome 3 -->
          <div class="outcome-card">
            <div class="outcome-num">03</div>
            <div class="outcome-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            </div>
            <h3 class="outcome-title">SPEED</h3>
            <p class="outcome-text">
              87% of homeowners hire whoever responds first. Every new lead gets an immediate 5-second SMS response and consistent multi-touch follow-up.
            </p>
          </div>

          <!-- Outcome 4 -->
          <div class="outcome-card">
            <div class="outcome-num">04</div>
            <div class="outcome-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            </div>
            <h3 class="outcome-title">CONTROL</h3>
            <p class="outcome-text">
              You get a clear, owner-friendly dashboard showing where leads come from, how fast they were contacted, and what turned into revenue.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 4. THE 7-PILLAR OFFER STACK ================= -->
    <section class="section stack-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">THE COMPLETE MACHINERY</span>
          <h2 class="section-title">THE 7-PART LOCAL CLIENT ENGINE™ STACK</h2>
          <p class="section-subtitle">
            Everything built, managed, and optimized for your business under one accountable roof.
          </p>
        </div>

        <div class="stack-list">
          <!-- Pillar 1 -->
          <div class="stack-card">
            <div class="stack-num">1</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>Local Demand Launch & Territory Strategy</h3>
                <span class="stack-badge">FOUNDATION</span>
              </div>
              <p>We map your most profitable high-ticket services, target zip codes, customer demographics, and margin thresholds. You get a laser-focused acquisition blueprint instead of burning budget on random broad ads.</p>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="stack-card">
            <div class="stack-num">2</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>High-Conversion Local Web & Mobile Presence</h3>
                <span class="stack-badge">CONVERSION</span>
              </div>
              <p>We build or upgrade your online presence so local homeowners instantly understand what you do, why you're trusted, and how to request an estimate in under 30 seconds. Engineered for speed, trust signals, and high conversion.</p>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="stack-card">
            <div class="stack-num">3</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>5-Second Speed-to-Lead & Follow-Up Automation (GHL)</h3>
                <span class="stack-badge">SPEED</span>
              </div>
              <p>Every phone call, form fill, or ad lead is immediately met with a personalized 5-second SMS response. Unanswered calls trigger instant text rescue sequences so hot leads never jump to a competitor.</p>
            </div>
          </div>

          <!-- Pillar 4 -->
          <div class="stack-card">
            <div class="stack-num">4</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>Managed Local Lead Generation (Google LSA + Meta Ads)</h3>
                <span class="stack-badge">DEMAND</span>
              </div>
              <p>We launch and manage high-intent Google Local Services Ads (with the Google Guaranteed badge) and targeted Meta campaigns. Every campaign is laser-focused on profitable jobs, not vanity impressions.</p>
            </div>
          </div>

          <!-- Pillar 5 -->
          <div class="stack-card">
            <div class="stack-num">5</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>Booking & Pipeline Visibility Dashboard</h3>
                <span class="stack-badge">VISIBILITY</span>
              </div>
              <p>Get a crystal-clear CRM pipeline on desktop and mobile. See new leads, booked estimates, quotes sent, jobs won, and revenue produced in one clean view.</p>
            </div>
          </div>

          <!-- Pillar 6 -->
          <div class="stack-card">
            <div class="stack-num">6</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>Weekly Growth & Spend Optimization</h3>
                <span class="stack-badge">OPTIMIZATION</span>
              </div>
              <p>We constantly review lead quality, cut low-performing zip codes, refine ad copy, and optimize follow-up cadences. You get an actively managed growth asset that gets smarter every month.</p>
            </div>
          </div>

          <!-- Pillar 7 -->
          <div class="stack-card">
            <div class="stack-num">7</div>
            <div class="stack-content">
              <div class="stack-header">
                <h3>Owner-Friendly Plain-English Reporting</h3>
                <span class="stack-badge">ACCOUNTABILITY</span>
              </div>
              <p>No confusing marketing jargon or vanity metrics. We report on the only numbers that matter to a business owner: qualified inquiries, appointment show rates, and booked revenue.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 5. HIGH-VALUE INCLUDED BONUSES ================= -->
    <section class="section bonuses-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">REMOVING ALL OBSTACLES</span>
          <h2 class="section-title">5 EXCLUSIVE ACCELERATOR BONUSES</h2>
          <p class="section-subtitle">
            Built-in tools and campaigns designed to accelerate speed to results and maximize ROI from day one.
          </p>
        </div>

        <div class="bonuses-grid">
          <!-- Bonus 1 -->
          <div class="bonus-card">
            <div class="bonus-tag">BONUS 1</div>
            <h3>Missed-Lead Recovery Campaign</h3>
            <p>An automated reactivation sequence that contacts your old inquiries, unsold quotes, and past customers to unlock immediate hidden revenue.</p>
          </div>

          <!-- Bonus 2 -->
          <div class="bonus-card">
            <div class="bonus-tag">BONUS 2</div>
            <h3>Service Area & Profit Margin Review</h3>
            <p>A strategic analysis identifying which high-ticket services and affluent zip codes should receive marketing budget first.</p>
          </div>

          <!-- Bonus 3 -->
          <div class="bonus-card">
            <div class="bonus-tag">BONUS 3</div>
            <h3>Call & Form Conversion Audit</h3>
            <p>A hands-on review of your inbound sales process to ensure your team closes the highest percentage of estimates possible.</p>
          </div>

          <!-- Bonus 4 -->
          <div class="bonus-card">
            <div class="bonus-tag">BONUS 4</div>
            <h3>Automated 5-Star Google Review System</h3>
            <p>A frictionless SMS trigger sent right after you finish a job that turns satisfied homeowners into glowing Google reviews.</p>
          </div>

          <!-- Bonus 5 -->
          <div class="bonus-card">
            <div class="bonus-tag">BONUS 5</div>
            <h3>30-Day Opportunity Dashboard</h3>
            <p>Custom mobile CRM setup so you can track leads, listen to call recordings, and message customers right from your truck.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 6. PACKAGING & TIERS ================= -->
    <section class="section packages-section" id="packages">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">TRANSPARENT PACKAGING</span>
          <h2 class="section-title">CHOOSE YOUR GROWTH VEHICLE</h2>
          <p class="section-subtitle">
            Direct management without hidden fees. Media ad spend is separate and paid directly to Google/Meta so you keep 100% control of your budget.
          </p>
        </div>

        <div class="packages-grid">
          <!-- Tier 1: Engine Launch -->
          <div class="pkg-card">
            <div class="pkg-badge">INFRASTRUCTURE</div>
            <h3 class="pkg-name">Engine Launch</h3>
            <p class="pkg-for">Best for contractors needing the foundation built right before scaling.</p>
            <div class="pkg-outcome">
              <strong>Main Outcome:</strong> A live, trackable lead-to-booking system with instant response automations.
            </div>
            <ul class="pkg-features">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> High-Conversion Website / Landing Experience</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Complete GHL CRM Pipeline Setup</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> 5-Second Automated SMS Speed-to-Lead</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Missed-Call Auto-Rescue Bot</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Google LSA & Meta Ads Architecture Setup</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Build-and-Launch Guarantee</li>
            </ul>
            <a href="#assessment" class="btn btn-dark btn-block">REQUEST ASSESSMENT</a>
          </div>

          <!-- Tier 2: Engine Growth (Featured) -->
          <div class="pkg-card featured">
            <div class="featured-ribbon">MOST POPULAR • CORE OFFER</div>
            <div class="pkg-badge highlight-badge">COMPLETE GROWTH ENGINE</div>
            <h3 class="pkg-name">Engine Growth</h3>
            <p class="pkg-for">Best for local service contractors who want a full done-for-you lead and booking system.</p>
            <div class="pkg-outcome">
              <strong>Main Outcome:</strong> Steady flow of qualified local homeowner inquiries and consistent booked estimates.
            </div>
            <ul class="pkg-features">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Everything in Engine Launch</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Active Google LSA Ads Management</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Active Meta Ads Campaign Management</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Weekly Spend & Bid Optimization</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>5-Star Review Request Automation</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Missed-Lead Reactivation Campaigns</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Bi-Weekly Performance Calls & Reports</strong></li>
            </ul>
            <a href="#assessment" class="btn btn-neon btn-block">CLAIM ENGINE GROWTH</a>
          </div>

          <!-- Tier 3: Engine Pro -->
          <div class="pkg-card">
            <div class="pkg-badge">MULTI-SERVICE / EXPANSION</div>
            <h3 class="pkg-name">Engine Pro</h3>
            <p class="pkg-for">For established operators expanding service areas or scaling multiple crews.</p>
            <div class="pkg-outcome">
              <strong>Main Outcome:</strong> Aggressive multi-city dominance, custom funnels, and sales process refinement.
            </div>
            <ul class="pkg-features">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Everything in Engine Growth</strong></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Multi-Territory & Multi-County Campaigns</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Multiple Service-Specific Landing Funnels</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Call Recording Reviews & Close-Rate Coaching</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Advanced Creative & Video Ad Testing</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Priority VIP Communication Channel</li>
            </ul>
            <a href="#assessment" class="btn btn-dark btn-block">REQUEST PRO AUDIT</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 7. WHO THIS IS FOR VS NOT FOR ================= -->
    <section class="section fit-section">
      <div class="container">
        <div class="fit-grid">
          <!-- Perfect Fit -->
          <div class="fit-card good-fit">
            <div class="fit-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <h3>THIS IS FOR YOU IF:</h3>
            </div>
            <ul>
              <li>You run a legitimate local service business (HVAC, Plumbing, Roofing, Remodeling, Landscaping, Concrete, Electrical, etc.).</li>
              <li>You have a proven track record of doing great work and the crew capacity to handle more jobs.</li>
              <li>You are tired of paying for shared leads or hoping for word-of-mouth.</li>
              <li>You or someone on your team will answer phone calls or reply to hot text notifications promptly.</li>
              <li>You are willing to invest an advertising budget into real business growth.</li>
            </ul>
          </div>

          <!-- Poor Fit -->
          <div class="fit-card bad-fit">
            <div class="fit-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              <h3>THIS IS NOT FOR YOU IF:</h3>
            </div>
            <ul>
              <li>You do not have the capacity or crew to take on additional estimates or jobs.</li>
              <li>You refuse to respond to leads in a reasonable timeframe or track your sales pipeline.</li>
              <li>You are looking for overnight get-rich-quick results with zero advertising budget.</li>
              <li>You have serious fulfillment issues, severe negative reputation, or untrustworthy workmanship.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 8. RISK REVERSAL & GUARANTEES ================= -->
    <section class="section guarantee-section">
      <div class="container flex-column align-center">
        <div class="guarantee-card">
          <div class="guarantee-shield">
