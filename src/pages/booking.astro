---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Book Your Strategy Call | Your Web Club"
  description="Pick a time that works for you to lock in your free strategy call."
>
  <Header />
  <main>
    <section class="section booking-section">
      <div class="container flex-column align-center">
        <h1 class="booking-heading">Book Your Strategy Call</h1>
        <p class="booking-subheading">You're almost there — pick a time below that works best for you.</p>

        <div class="booking-embed">
          <iframe
            src="https://link.yourwebclub.com/widget/booking/IiMXa8tjg71xunqbWOnY"
            style="width: 100%; border: none; overflow: hidden;"
            scrolling="no"
            id="IiMXa8tjg71xunqbWOnY_1787258471758"
            allow="payment"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="https://link.yourwebclub.com/js/form_embed.js"></script>
</Layout>

<style>
  .booking-section {
    padding: 4.5rem 0 6rem 0;
  }

  .booking-heading {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .booking-subheading {
    font-size: 1.1rem;
    color: #cbd5e1;
    text-align: center;
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  .booking-embed {
    width: 100%;
    max-width: 900px;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 768px) {
    .booking-heading {
      font-size: 1.75rem;
    }
    .booking-subheading {
      font-size: 1rem;
    }
  }
</style>
