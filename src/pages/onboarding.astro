  }

  .submit-guarantee {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(112, 224, 0, 0.08);
    border: 1.5px solid var(--neon-green);
    padding: 0.85rem 1.25rem;
    color: #f1f5f9;
    font-size: 0.85rem;
  }

  .shield-icon {
    width: 22px;
    height: 22px;
    color: var(--neon-green);
    flex-shrink: 0;
  }

  .btn-submit-final {
    font-size: 0.95rem;
    padding: 1.1rem 2rem;
  }

  .hp-input {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  /* Success Card */
  .success-card {
    background: #181b20;
    border: 2.5px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    padding: 3.5rem 3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .success-card.hidden {
    display: none;
  }

  .success-icon-wrap {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: rgba(112, 224, 0, 0.15);
    border: 2.5px solid var(--neon-green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .success-icon-wrap svg {
    width: 38px;
    height: 38px;
    color: var(--neon-green);
  }

  .success-badge {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--neon-green);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .success-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .success-subtitle {
    font-size: 1.05rem;
    color: #cbd5e1;
    max-width: 620px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .roadmap-card {
    background: #0f1115;
