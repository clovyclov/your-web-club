  }

  .roadmap-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--neon-green);
    color: #000000;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .roadmap-info h4 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .roadmap-info p {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.45;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .onboarding-title {
      font-size: 1.85rem;
    }
    .onboarding-form {
      padding: 2rem 1.25rem;
    }
    .form-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .span-2 {
      grid-column: span 1;
    }
    .progress-card {
      padding: 1.25rem 1rem;
    }
    .step-indicators {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
    .node-label {
      font-size: 0.75rem;
    }
    .form-actions {
      flex-direction: column-reverse;
      width: 100%;
    }
    .form-actions button {
      width: 100%;
    }
    .success-card {
      padding: 2rem 1.25rem;
    }
    .success-title {
      font-size: 1.85rem;
    }
    .roadmap-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>

<script>
  const WEBHOOK_URL = 'https://services.leadconnectorhq.com/hooks/TSqcO2Er7wAliwNMEQpv/webhook-trigger/899407be-efbe-4c5f-97c2-fd2cd9477633';
  const STORAGE_KEY = 'ywc_onboarding_draft';

  let currentStep = 1;
  const totalSteps = 4;

  const form = document.getElementById('onboardingForm') as HTMLFormElement | null;
  const progressBar = document.getElementById('progressBar');
  const successCard = document.getElementById('successCard');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  // Checkbox helpers to auto-fill text inputs
  const setupCheckboxHelper = (chkId: string, inputId: string, defaultText: string) => {
    const chk = document.getElementById(chkId) as HTMLInputElement | null;
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (chk && input) {
      chk.addEventListener('change', () => {
        if (chk.checked) {
          input.value = defaultText;
          input.disabled = true;
        } else {
          input.disabled = false;
          input.value = '';
        }
      });
    }
  };

  setupCheckboxHelper('noLogoCheckbox', 'logoLink', 'Need logo designed / No logo file currently');
  setupCheckboxHelper('noGbpCheckbox', 'googleBusinessUrl', 'No Google Business Profile yet');
  setupCheckboxHelper('photosLaterCheckbox', 'projectPhotosLink', 'Will email/text project photos to build team');
  setupCheckboxHelper('noFbCheckbox', 'facebookPageUrl', 'No Facebook Business Page yet');

  // Multi-step navigation logic
  const updateStepView = (step: number) => {
    currentStep = step;
    const steps = document.querySelectorAll('.form-step');
    steps.forEach((s) => {
      const stepNum = parseInt(s.getAttribute('data-step') || '1', 10);
      s.classList.toggle('active', stepNum === currentStep);
    });

    // Update Progress bar
    if (progressBar) {
      const percentage = (currentStep / totalSteps) * 100;
      progressBar.style.width = `${percentage}%`;
    }

    // Update Step Indicators
    const indicators = document.querySelectorAll('.step-node');
    indicators.forEach((node) => {
      const indNum = parseInt(node.getAttribute('data-step-indicator') || '1', 10);
      node.classList.toggle('active', indNum === currentStep);
      node.classList.toggle('completed', indNum < currentStep);
    });

    window.scrollTo({ top: 180, behavior: 'smooth' });
  };

  // Step Validation
  const validateStep = (step: number): boolean => {
    const stepEl = document.querySelector(`.form-step[data-step="${step}"]`);
    if (!stepEl) return true;

    const requiredInputs = stepEl.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]');
    let isValid = true;

    requiredInputs.forEach((input) => {
      if (input.disabled) return;
      if (!input.checkValidity() || !input.value.trim()) {
        isValid = false;
        input.reportValidity();
      }
    });

    return isValid;
  };

  // Next Buttons
  document.querySelectorAll('.btn-next').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextStep = parseInt(btn.getAttribute('data-next') || '1', 10);
      if (validateStep(currentStep)) {
        updateStepView(nextStep);
        saveDraft();
      }
    });
  });

  // Prev Buttons
  document.querySelectorAll('.btn-prev').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prevStep = parseInt(btn.getAttribute('data-prev') || '1', 10);
      updateStepView(prevStep);
    });
  });

  // Draft saving in localStorage
  const saveDraft = () => {
    if (!form) return;
    const formData = new FormData(form);
    const data: Record<string, string> = {};
    formData.forEach((value, key) => {
      if (key !== '_hp_site') data[key] = value.toString();
    });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  };

  const loadDraft = () => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved || !form) return;
    try {
      const data = JSON.parse(saved);
      Object.keys(data).forEach((key) => {
        const field = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (field) {
          if (field instanceof RadioNodeList) {
            field.value = data[key];
          } else {
            field.value = data[key];
          }
        }
      });
    } catch (e) {
      console.error('Error loading draft', e);
    }
  };

  loadDraft();

  // Handle Form Submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Check honeypot
    const hp = (document.getElementById('hpSite') as HTMLInputElement)?.value;
    if (hp && hp.trim() !== '') {
      form.style.display = 'none';
      successCard?.classList.remove('hidden');
      return;
    }

    if (!validateStep(4)) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span>Submitting Onboarding...</span>
      `;
    }

    const formData = new FormData(form);
    const payload: Record<string, any> = {
      form_name: 'Client Onboarding - Contractor Revenue Engine',
      submitted_at: new Date().toISOString(),
      businessName: formData.get('businessName') || '',
      ownerName: formData.get('ownerName') || '',
      ownerPhone: formData.get('ownerPhone') || '',
      businessPhone: formData.get('businessPhone') || '',
      email: formData.get('email') || '',
      businessAddress: formData.get('businessAddress') || '',
      primaryTrade: formData.get('primaryTrade') || '',
      topServices: formData.get('topServices') || '',
      disqualifiedServices: formData.get('disqualifiedServices') || '',
      serviceArea: formData.get('serviceArea') || '',
      estimateType: formData.get('estimateType') || 'Free In-Person Estimates',
      logoLink: formData.get('logoLink') || '',
      googleBusinessUrl: formData.get('googleBusinessUrl') || '',
      projectPhotosLink: formData.get('projectPhotosLink') || '',
      domainRegistrar: formData.get('domainRegistrar') || '',
      facebookPageUrl: formData.get('facebookPageUrl') || '',
      additionalNotes: formData.get('additionalNotes') || '',
    };

    try {
      await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      // Clear draft
      localStorage.removeItem(STORAGE_KEY);

      // Show success screen
      form.style.display = 'none';
      const progressNode = document.querySelector('.progress-card') as HTMLElement | null;
      if (progressNode) progressNode.style.display = 'none';
      successCard?.classList.remove('hidden');
      window.scrollTo({ top: 120, behavior: 'smooth' });
    } catch (err) {
      console.error('Submission error:', err);
      alert('There was a slight connection issue submitting the form. Please try again or reach out to support.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <span>COMPLETE ONBOARDING & LAUNCH</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        `;
      }
    }
  });
</script>
