---
import Layout from '../layouts/Layout.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Free Google Ads Audit for Local Contractors & Trade Businesses | Your Web Club"
  description="Stop wasting money on junk clicks, DIY search terms, and broken conversion tracking. Get a confidential line-by-line Google Ads audit for your local home service business."
>
  <!-- Mini Top Bar Navigation -->
  <header class="audit-header">
    <div class="container header-container">
      <a href="/" class="logo-link">
        <img
          src="/logos/ywc-logo.png"
          alt="Your Web Club logo"
          class="logo-img"
        />
      </a>
      <div class="header-badges">
        <span class="header-pill">LOCAL HOME SERVICE AUDIT</span>
        <a href="#audit-booking" class="btn btn-neon btn-sm">BOOK AUDIT CALL</a>
      </div>
    </div>
  </header>

  <main class="audit-main">
    <!-- ================= 1. HERO SECTION WITH DIRECT AUDIT LEAD FORM ================= -->
    <section class="section audit-hero">
      <div class="container hero-layout">
        <!-- Hero Text & Value Proposition -->
        <div class="hero-content">
          <div class="audit-badge">
            <span class="badge-dot"></span>
            <span>100% CONFIDENTIAL • NO PASSWORD REQUIRED</span>
          </div>

          <h1 class="hero-title">
            WHERE IS YOUR GOOGLE ADS BUDGET <span class="highlight">LEAKING CASH?</span>
          </h1>

          <p class="hero-subtitle">
            Most local contractors waste 30% to 50% of their monthly Google Ads budget on DIY searches, job seekers, and clicks outside their dispatch territory. We review your search term reports, bidding setup, and conversion tracking to show you where money is bleeding and how to book real homeowner estimates.
          </p>

          <div class="hero-proof-list">
            <div class="proof-row">
              <div class="proof-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="proof-text">
                <strong>Search Query Bleed:</strong> Uncover exact queries like "free scrap haul" or "how to fix AC yourself" you paid $25+ per click for.
              </div>
            </div>

            <div class="proof-row">
              <div class="proof-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="proof-text">
                <strong>Conversion Integrity:</strong> Find out if your agency tracks real inbound calls or inflated 2-second pageviews.
              </div>
            </div>

            <div class="proof-row">
              <div class="proof-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="proof-text">
                <strong>Zero Password Access:</strong> You grant secure read-only viewer access through your Google Ads ID, or we do a live screen share.
              </div>
            </div>
          </div>

          <div class="hero-quick-switch">
            <span>Want to jump straight to calendar booking?</span>
            <a href="#audit-booking">Pick a 20-minute call time &rarr;</a>
          </div>
        </div>

        <!-- Hero Audit Request Lead Form Card -->
        <div class="hero-form-column" id="audit-form">
          <div class="form-card">
            <div class="form-header">
              <span class="card-kicker">FREE ACCOUNT TEARDOWN</span>
              <h2 class="card-title">REQUEST YOUR GOOGLE ADS AUDIT</h2>
              <p class="card-desc">
                Fill in your details below. We review your actual search terms and email your private video teardown within 48 business hours.
              </p>
            </div>

            <form id="heroAuditForm" class="audit-lead-form">
              <input type="text" name="_hp_site" id="hpSite" class="hp-input" tabindex="-1" autocomplete="off" />

              <div class="form-row grid-2">
                <div class="form-group">
                  <label for="auditFullName">Your Name <span class="req">*</span></label>
                  <input type="text" id="auditFullName" name="fullName" placeholder="e.g. Mike Miller" required />
                </div>
                <div class="form-group">
                  <label for="auditBusinessName">Company Name <span class="req">*</span></label>
                  <input type="text" id="auditBusinessName" name="businessName" placeholder="e.g. Miller Heating & Cooling" required />
                </div>
              </div>

              <div class="form-row grid-2">
                <div class="form-group">
                  <label for="auditPhone">Phone Number <span class="req">*</span></label>
                  <input type="tel" id="auditPhone" name="phone" placeholder="e.g. (555) 234-5678" required />
                </div>
                <div class="form-group">
                  <label for="auditEmail">Business Email <span class="req">*</span></label>
                  <input type="email" id="auditEmail" name="email" placeholder="e.g. mike@millerhvac.com" required />
                </div>
              </div>

              <div class="form-row grid-2">
                <div class="form-group">
                  <label for="auditTrade">Primary Trade <span class="req">*</span></label>
                  <select id="auditTrade" name="trade" required>
                    <option value="" disabled selected>Select your trade...</option>
                    <option value="HVAC">Heating & Air Conditioning (HVAC)</option>
                    <option value="Roofing">Roofing & Siding</option>
                    <option value="Plumbing">Plumbing & Drain Cleaning</option>
                    <option value="Dumpster / Junk">Dumpster Rental / Junk Removal</option>
                    <option value="Landscaping">Landscaping & Hardscaping</option>
                    <option value="Remodeling">Remodeling & General Contractor</option>
                    <option value="Electrical">Electrical Contractor</option>
                    <option value="Concrete / Foundation">Concrete & Foundation</option>
                    <option value="Other Trade">Other Home Service Trade</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="auditSpend">Monthly Google Ads Spend <span class="req">*</span></label>
                  <select id="auditSpend" name="spend" required>
                    <option value="" disabled selected>Select ad budget...</option>
                    <option value="$1,000 - $3,000 / month">$1,000 - $3,000 / month</option>
                    <option value="$3,000 - $7,500 / month">$3,000 - $7,500 / month</option>
                    <option value="$7,500 - $15,000 / month">$7,500 - $15,000 / month</option>
                    <option value="$15,000+ / month">$15,000+ / month</option>
                    <option value="Planning to launch">Planning to launch soon</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="auditWebsite">Website or 10-Digit Google Ads Customer ID</label>
                <input type="text" id="auditWebsite" name="website" placeholder="e.g. www.millerhvac.com or 123-456-7890" />
              </div>

              <div class="form-group">
                <label for="auditNotes">Biggest Ad Frustration (Optional)</label>
                <input type="text" id="auditNotes" name="notes" placeholder="e.g. Too many tire kickers, cost per lead keeps rising" />
              </div>

              <button type="submit" class="btn btn-neon btn-block btn-submit">
                REQUEST MY CONFIDENTIAL AUDIT
              </button>

              <div class="form-footer-guarantee">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lock-mini">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Safe & Secure. We never sell your data or touch your live account without permission.</span>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 2. SOCIAL PROOF / VIDEO TESTIMONIALS (SPOT 2) ================= -->
    <VideoTestimonials
      kicker="PROVEN CONTRACTOR RESULTS"
      title="HEAR DIRECTLY FROM REAL BUSINESS OPERATORS"
      subtitle="Watch local business owners share how our Google Ads management, high-converting websites, and lead follow-up stopped budget bleed and generated qualified local inquiries."
    />

    <!-- ================= 3. THE 6 FATAL LEAKS IN CONTRACTOR GOOGLE ADS ================= -->
    <section class="section leaks-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">WHERE MONEY DISAPPEARS</span>
          <h2 class="section-title">THE 6 COSTLIEST GOOGLE ADS MISTAKES IN LOCAL HOME SERVICES</h2>
          <p class="section-subtitle">
            Google's automated defaults are designed to maximize Google's revenue, not your contractor net profit. These are the exact issues we discover in 9 out of 10 contractor audits.
          </p>
        </div>

        <div class="leaks-grid">
          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">01</span>
              <h3>Search Term Bleed & Zero Negative Lists</h3>
            </div>
            <p>
              Contractors pay $30 to $65 for clicks on phrases like "free scrap pickup", "cheap roof repair kit", or "hvac jobs hiring". Without trade-specific negative keyword lists, Google gladly charges you full price for unqualified DIYers.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> 25% to 40% of monthly budget lost to non-buyers.
            </div>
          </div>

          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">02</span>
              <h3>Phantom & Inflated "Conversions"</h3>
            </div>
            <p>
              Your agency dashboard shows 50 "conversions", but your phone only rang 8 times. We routinely find agencies counting visits to the contact page, 3-second accidental button clicks, or newsletter signups as valid customer leads.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> False reporting that hides poor campaign performance.
            </div>
          </div>

          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">03</span>
              <h3>Radius Slippage ("Presence or Interest")</h3>
            </div>
            <p>
              Google defaults your location targeting to people "in, or who show interest in" your target area. That means someone 200 miles away researching houses in your city triggers your emergency plumbing or roofing ads.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> Clicks billed for customers outside your physical service radius.
            </div>
          </div>

          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">04</span>
              <h3>Broad Match Auto-Apply Bleed</h3>
            </div>
            <p>
              Google's account recommendations push contractors into pure Broad Match with Smart Bidding. Without massive conversion volume, Google matches your ads to random queries that have nothing to do with high-margin jobs.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> Skyrocketing cost per lead with lower closing rates.
            </div>
          </div>

          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">05</span>
              <h3>Broken Mobile Landing Experience</h3>
            </div>
            <p>
              Over 70% of local homeowner service emergencies happen on mobile devices. When paid clicks land on a slow, cluttered site without a direct tap-to-call button or immediate 5-second SMS responder, homeowners bounce to the next listing.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> 50%+ bounce rate on clicks you already paid for.
            </div>
          </div>

          <div class="leak-card">
            <div class="leak-header">
              <span class="leak-num">06</span>
              <h3>Low Quality Score Penalties</h3>
            </div>
            <p>
              When your ad copy, search keywords, and destination landing page do not tightly align, Google assigns low Quality Scores (3/10 or 4/10). Google penalizes low scores by charging you up to 40% more per click than your top local competitor.
            </p>
            <div class="leak-impact">
              <strong>Cost:</strong> You pay higher prices for worse ad positions.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 4. REAL AUDIT FINDINGS: BEFORE VS AFTER ================= -->
    <section class="section case-breakdown-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">REAL ACCOUNT TEARDOWNS</span>
          <h2 class="section-title">WHAT WE UNCOVER IN TYPICAL CONTRACTOR AUDITS</h2>
          <p class="section-subtitle">
            Concrete examples from audits conducted on active local trade accounts.
          </p>
        </div>

        <div class="case-grid">
          <!-- Case 1: Dumpster Rental -->
          <div class="case-card">
            <div class="case-badge">DUMPSTER RENTAL & WASTE</div>
            <h3>Metro Dumpster Service ($4,200/mo spend)</h3>
            <div class="case-split">
              <div class="case-side before">
                <span class="side-tag bad">BEFORE AUDIT</span>
                <ul>
                  <li>44% of spend went to searches like "city dump hours", "free appliance disposal", and "trash can replacement".</li>
                  <li>Conversions tracked on button hover rather than completed calls.</li>
                  <li>Cost per valid booking: $168.</li>
                </ul>
              </div>
              <div class="case-side after">
                <span class="side-tag good">AFTER AUDIT</span>
                <ul>
                  <li>Added 520+ negative keywords blocking municipal waste terms and free scrap queries.</li>
                  <li>Rewired conversion tracking to verify phone calls lasting over 60 seconds.</li>
                  <li>Cost per valid booking dropped to $71 (57% reduction).</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Case 2: HVAC Contractor -->
          <div class="case-card">
            <div class="case-badge">HEATING & COOLING</div>
            <h3>Residential HVAC Contractor ($6,500/mo spend)</h3>
            <div class="case-split">
              <div class="case-side before">
                <span class="side-tag bad">BEFORE AUDIT</span>
                <ul>
                  <li>Location targeting set to "Presence or Interest", delivering clicks from 40 miles away across state lines.</li>
                  <li>Broad match bidding on "AC fix" triggering YouTube tutorial searchers.</li>
                  <li>Cost per booked estimate: $240.</li>
                </ul>
              </div>
              <div class="case-side after">
                <span class="side-tag good">AFTER AUDIT</span>
                <ul>
                  <li>Strict zip code radius targeting with strict "Presence only" exclusion.</li>
                  <li>Replaced runaway broad match with high-intent phrase match keywords.</li>
                  <li>Cost per booked estimate dropped to $112, doubling weekly estimate volume.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 5. WHAT OUR AUDIT COVERS (THE CHECKLIST) ================= -->
    <section class="section checklist-section">
      <div class="container">
        <div class="checklist-wrapper">
          <div class="checklist-info">
            <span class="section-kicker">COMPREHENSIVE TEARDOWN</span>
            <h2 class="section-title">THE 7-POINT CONTRACTOR AUDIT CHECKLIST</h2>
            <p class="section-desc">
              We don't run automated software reports that spit out generic vanity graphs. We manually inspect your raw account history to deliver concrete, actionable fixes.
            </p>
            <a href="#audit-booking" class="btn btn-neon btn-lg">SCHEDULE YOUR AUDIT REVIEW</a>
          </div>

          <div class="checklist-items">
            <div class="chk-item">
              <div class="chk-num">1</div>
              <div class="chk-content">
                <h4>90-Day Search Query Report Review</h4>
                <p>We review every search query that triggered your ads, identifying specific phrases that spent money without generating a real lead.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">2</div>
              <div class="chk-content">
                <h4>Negative Keyword Library Audit</h4>
                <p>We evaluate your active negative keyword lists and compare them against our contractor negative library containing over 500+ proven wasted terms.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">3</div>
              <div class="chk-content">
                <h4>Call Tracking & Conversion Signal Test</h4>
                <p>We test your conversion actions to ensure only qualified phone calls (above 60s duration) and valid estimate forms count as conversions.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">4</div>
              <div class="chk-content">
                <h4>Geo-Targeting & Exclusion Boundaries</h4>
                <p>We verify your target radius, excluded zip codes, and geographic settings so you stop paying for users outside your service territory.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">5</div>
              <div class="chk-content">
                <h4>Device Breakdown & Bid Adjustments</h4>
                <p>We analyze whether your budget is disproportionately burned on desktop browsers vs high-converting mobile phone calls.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">6</div>
              <div class="chk-content">
                <h4>Quality Score & Ad Copy Relevance</h4>
                <p>We check Quality Scores across your core high-margin services to identify ad groups driving up your cost-per-click.</p>
              </div>
            </div>

            <div class="chk-item">
              <div class="chk-num">7</div>
              <div class="chk-content">
                <h4>Landing Page Speed & Mobile Conversion Flow</h4>
                <p>We review your mobile destination page to determine whether searchers can easily call your office and whether missed calls are rescued via SMS.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 6. HOW THE AUDIT PROCESS WORKS ================= -->
    <section class="section process-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">SIMPLE & ZERO RISK</span>
          <h2 class="section-title">HOW YOUR FREE AUDIT WORKS</h2>
          <p class="section-subtitle">
            No password sharing. No pushy sales calls. Just honest analysis of your account data.
          </p>
        </div>

        <div class="process-steps">
          <div class="step-card">
            <div class="step-header">
              <span class="step-badge">STEP 1</span>
              <h3>Submit Details or Pick a Time</h3>
            </div>
            <p>Fill out the form above or pick a convenient 20-minute slot on our calendar below.</p>
          </div>

          <div class="step-card">
            <div class="step-header">
              <span class="step-badge">STEP 2</span>
              <h3>Safe Read-Only Access</h3>
            </div>
            <p>Send us your 10-digit Google Ads ID. We send a standard read-only viewer link through Google. We never ask for passwords.</p>
          </div>

          <div class="step-card">
            <div class="step-header">
              <span class="step-badge">STEP 3</span>
              <h3>Line-by-Line Investigation</h3>
            </div>
            <p>We dive into your past 90 days of search terms, bids, location data, and conversion actions to locate exact areas of waste.</p>
          </div>

          <div class="step-card">
            <div class="step-header">
              <span class="step-badge">STEP 4</span>
              <h3>Video Teardown & Action Plan</h3>
            </div>
            <p>You receive a private video walkthrough and an actionable list of negative keywords, bidding adjustments, and fixes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 7. GHL CALENDAR EMBED FOR DIRECT CALL BOOKING ================= -->
    <section class="section booking-section" id="audit-booking">
      <div class="container flex-column align-center">
        <div class="section-header text-center">
          <span class="section-kicker">DIRECT SCHEDULE</span>
          <h2 class="section-title">SCHEDULE YOUR 1-ON-1 AUDIT REVIEW</h2>
          <p class="section-subtitle">
            Prefer to review your account live on a screenshare? Choose a time below that works best for your schedule.
          </p>
        </div>

        <div class="booking-embed-card">
          <iframe
            src="https://link.yourwebclub.com/widget/booking/IiMXa8tjg71xunqbWOnY"
            style="width: 100%; border: none; overflow: hidden; min-height: 600px;"
            scrolling="no"
            id="IiMXa8tjg71xunqbWOnY_audit"
            allow="payment"
          ></iframe>
        </div>

        <p class="cta-guarantee-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shield-mini">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          100% Confidential. Zero Sales Pressure. Read-Only Access Only.
        </p>
      </div>
    </section>

    <script is:inline src="https://link.yourwebclub.com/js/form_embed.js"></script>

    <!-- ================= 8. FREQUENTLY ASKED QUESTIONS ================= -->
    <section class="section faq-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-kicker">QUESTIONS & ANSWERS</span>
          <h2 class="section-title">COMMON QUESTIONS ABOUT THE AUDIT</h2>
        </div>

        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>Do I have to give you my Google account password?</span>
              <svg class="faq-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="faq-answer">
              <p>No. You provide your 10-digit Google Ads Customer ID (found in the top corner of your Google Ads account). We send an official read-only viewer request through Google's manager portal. You can revoke access at any time with one click.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Will you make any changes to my live campaigns?</span>
              <svg class="faq-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="faq-answer">
              <p>Never. Read-only access does not allow us to edit, alter, or pause anything in your account. We only inspect your data to identify wasted spend and missed opportunities.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How much do I need to be spending on Google Ads to qualify?</span>
              <svg class="faq-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="faq-answer">
              <p>We recommend currently spending at least $1,000 per month on Google Ads. This ensures there is sufficient search query and bidding history to identify meaningful patterns and save you substantial budget.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What happens after the audit?</span>
              <svg class="faq-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="faq-answer">
              <p>You receive our complete findings and an action checklist. You can implement the recommendations yourself, give them to your existing agency, or hire us to manage your Google Ads and contractor lead systems. There is zero obligation.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How quickly will I receive my audit results?</span>
              <svg class="faq-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="faq-answer">
              <p>Once read-only access is granted, we typically complete your review and send your personalized video teardown within 48 business hours.</p>
            </div>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { submitLead } from '../lib/submitLead';

  const auditForm = document.getElementById('heroAuditForm') as HTMLFormElement | null;
  auditForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = auditForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Submitting Audit Request...';
    }

    const trade = (document.getElementById('auditTrade') as HTMLSelectElement)?.value || '';
    const spend = (document.getElementById('auditSpend') as HTMLSelectElement)?.value || '';
    const notes = (document.getElementById('auditNotes') as HTMLInputElement)?.value || '';

    submitLead(
      {
        fullName: (document.getElementById('auditFullName') as HTMLInputElement)?.value || '',
        businessName: (document.getElementById('auditBusinessName') as HTMLInputElement)?.value || '',
        phone: (document.getElementById('auditPhone') as HTMLInputElement)?.value || '',
        email: (document.getElementById('auditEmail') as HTMLInputElement)?.value || '',
        website: (document.getElementById('auditWebsite') as HTMLInputElement)?.value || '',
        notes: `Trade: ${trade} | Spend: ${spend} | Notes: ${notes}`,
        source: 'google-ads-audit-page'
      },
      '/booking'
    );
  });
</script>

<style>
  /* Header Styles */
  .audit-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 11, 13, 0.92);
