          <p class="feature-desc" set:html={item.description} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lead-system-section {
    padding-top: 3.5rem;
    padding-bottom: 5.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-white);
    letter-spacing: -0.01em;
  }

  .features-grid {
    gap: 1.75rem;
  }

  .feature-card {
    background: #262626;
    border: none;
    border-radius: 0;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
