<section class="section comparison-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">WHY CONTRACTORS ARE DITCHING LEAD AGENCIES & BROCHURE WEBSITES</h2>
      <p class="section-subtitle">See how the Contractor Revenue Engine™ compares to traditional options.</p>
    </div>

    <div class="table-wrapper">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="feature-col">FEATURE</th>
            <th class="bad-col">SHARED LEAD AGENCIES (Angi / HomeAdvisor)</th>
            <th class="bad-col">TRADITIONAL WEB DESIGNERS</th>
            <th class="good-col">CONTRACTOR REVENUE ENGINE™</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-title">Upfront Cost</td>
            <td class="bad-cell">$0 - $500 signup fees</td>
            <td class="bad-cell">$3,000 - $8,000 upfront</td>
            <td class="good-cell"><strong>$0 Upfront Build Fee</strong></td>
          </tr>
          <tr>
            <td class="feature-title">Monthly Maintenance</td>
            <td class="bad-cell">Pay-per-lead charges ($50-$150/ea)</td>
            <td class="bad-cell">$100-$300 hosting (No leads)</td>
            <td class="good-cell"><strong>$297/mo All-Inclusive</strong></td>
          </tr>
          <tr>
            <td class="feature-title">Lead Exclusivity</td>
            <td class="bad-cell">❌ Sold to 5+ competing contractors</td>
            <td class="bad-cell">❌ No lead generation included</td>
            <td class="good-cell"><strong>✔ 100% Exclusive To Your Business</strong></td>
          </tr>
          <tr>
            <td class="feature-title">Speed to Contact</td>
            <td class="bad-cell">❌ Manual call required (You're on a ladder)</td>
            <td class="bad-cell">❌ Form email lands in inbox 3 hrs later</td>
            <td class="good-cell"><strong>✔ Automated 5-Second SMS Response</strong></td>
          </tr>
          <tr>
            <td class="feature-title">Performance Guarantee</td>
            <td class="bad-cell">❌ None. You pay whether leads are bad or good</td>
            <td class="bad-cell">❌ None. Zero lead commitment</td>
            <td class="good-cell"><strong>✔ 14-Day Money-Back Guarantee</strong></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: 5.5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-white);
    max-width: 900px;
    margin: 0 auto 1rem auto;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: #cbd5e1;
  }

  .table-wrapper {
    overflow-x: auto;
    background: #181b20;
    border: none;
    border-radius: 0;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 800px;
  }

  .comparison-table th, .comparison-table td {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .comparison-table th {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .feature-col {
    background: #14161a;
    color: var(--text-muted);
    width: 25%;
  }

  .bad-col {
    background: #1c1f26;
    color: #f87171;
    width: 25%;
  }

  .good-col {
    background: rgba(112, 224, 0, 0.15);
    color: var(--neon-green);
    border-top: 3px solid var(--neon-green);
    width: 25%;
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .bad-cell {
    font-size: 0.9rem;
    color: #cbd5e1;
    background: #1c1f26;
  }

  .good-cell {
    font-size: 0.95rem;
    color: #ffffff;
    background: rgba(112, 224, 0, 0.08);
  }

  .good-cell strong {
    color: var(--neon-green);
  }
</style>
