---
---

<section class="meta-hero">
  <div class="container hero-container">
    <!-- Top Announcement Bar -->
    <div class="meta-announcement">
      <span class="announcement-text">Exclusively for Contractors, Landscapers, and Remodelers</span>
    </div>

    <!-- Main Headline with Clean Hierarchy -->
    <div class="hero-headline-wrapper">
      <h1 class="hero-title">
        Get An Automated High-Ticket Homeowner System That Guarantees <span class="highlight">10 Qualified Estimates</span> In 90 Days.
      </h1>
    </div>

    <!-- Video Embed Directly Under Headline -->
    <p class="video-cta-label">See EXACTLY What You Get for $297 👇</p>

    <div class="hero-video-wrapper">
      <div class="video-container" id="videoContainer">
        <video
          id="heroVideo"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="hero-video"
        >
          <source src="https://assets.cdn.filesafe.space/TSqcO2Er7wAliwNMEQpv/media/69f64ef06b07ab33031b7de7.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>

        <button class="tap-for-sound-btn" id="tapForSoundBtn" aria-label="Unmute video">
          <span class="sound-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" stroke="none"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
          </span>
          <span class="sound-label">Tap for sound</span>
        </button>

        <button class="pin-close-btn" id="pinCloseBtn" aria-label="Close floating video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Subheadline -->
    <p class="hero-subtitle">
      For just <strong>$297/mo</strong>, get an automated high-converting trade website, instant 5-minute SMS lead dispatch, and automatic Google review engine. 
      If we don't deliver 10 qualified homeowner estimate opportunities in your first 90 days, <strong>we work 100% free until we do.</strong>
    </p>

    <!-- CTAs & Guarantee Callout -->
    <div class="cta-wrapper">
      <a href="#claim-offer" class="btn btn-neon btn-lg">CLAIM YOUR 90-DAY GUARANTEE NOW</a>
      <p class="cta-subtext">No 12-month lock-in contract • Setup in as little as 7 days</p>
    </div>

    <!-- Key Trust Badges -->
    <div class="trust-badges">
      <div class="badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Ready in 7 days or less</span>
      </div>
      <div class="badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>100% Exclusive Homeowner Leads</span>
      </div>
      <div class="badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Work-For-Free Guarantee</span>
      </div>
    </div>
  </div>
</section>

<style>
  .meta-hero {
    padding: 4.5rem 0 4rem 0;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    max-width: 1020px;
  }

  /* Announcement Bar */
  .meta-announcement {
    display: inline-flex;
    align-items: center;
    background: #262626;
    border: 2.5px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    padding: 0.75rem 1.85rem;
    border-radius: 0;
    margin-bottom: -0.75rem;
  }

  .announcement-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* Headline Hierarchy Improvements */
  .hero-headline-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    max-width: 940px;
  }

  .hero-kicker {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--btn-orange);
    letter-spacing: 0.02em;
    background: rgba(249, 108, 44, 0.12);
    border: 1px solid rgba(249, 108, 44, 0.3);
    padding: 0.35rem 1.1rem;
    display: inline-block;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--text-white);
    letter-spacing: -0.01em;
    text-transform: none; /* Title Case for vastly superior readability */
  }

  .hero-title .highlight {
    color: var(--neon-green);
    font-weight: 900;
    text-decoration: underline;
    text-decoration-color: var(--neon-green);
    text-underline-offset: 6px;
    text-decoration-thickness: 3px;
  }

  /* Video Embed Styling */
  .video-cta-label {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--neon-green);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .hero-video-wrapper {
    width: 100%;
    max-width: 820px;
    margin: 0.5rem 0 0.5rem 0;
    /* Reserves the video's space even once .video-container becomes fixed */
    aspect-ratio: 16 / 9;
  }

  .video-container {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000000;
    border: 2.5px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .video-container.is-pinned {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 160px;
    height: auto;
    border: 3px solid #ef4444;
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
    z-index: 999;
    cursor: pointer;
    animation: slideInCorner 0.3s ease-out;
  }

  @keyframes slideInCorner {
    from {
      transform: translate(40px, -24px) scale(0.85);
      opacity: 0;
    }
    to {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
  }

  .video-container.is-pinned .tap-for-sound-btn {
    transform: translate(-50%, -50%) scale(0.55);
  }

  .video-container.is-pinned .sound-label {
    display: none;
  }

  .pin-close-btn {
    display: none;
    position: absolute;
    top: -10px;
    right: -10px;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #111111;
    border: 2px solid white;
    color: white;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .pin-close-btn svg {
    width: 12px;
    height: 12px;
  }

  .video-container.is-pinned .pin-close-btn {
    display: flex;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tap-for-sound-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    z-index: 5;
  }

  .sound-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    animation: soundPulse 2s ease-in-out infinite;
  }

  .sound-icon svg {
    width: 28px;
    height: 28px;
    color: white;
  }

  .sound-label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: rgba(0, 0, 0, 0.65);
    padding: 0.45rem 1.1rem;
    border-radius: 50px;
  }

  @keyframes soundPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 820px;
    line-height: 1.65;
  }

  .hero-subtitle strong {
    color: var(--text-white);
  }

  .cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-lg {
    padding: 1.2rem 3rem;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
  }

  .cta-subtext {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
  }

  .badge-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #e2e8f0;
  }

  .badge-item svg {
    width: 18px;
    height: 18px;
    stroke: var(--btn-orange);
  }

  @media (max-width: 768px) {
    .hero-kicker {
      font-size: 1rem;
    }
    .hero-title {
      font-size: 1.65rem;
      line-height: 1.3;
    }
    .video-cta-label {
      font-size: 1.1rem;
    }
    .video-container.is-pinned {
      width: 110px;
      top: 12px;
      right: 12px;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .trust-badges {
      gap: 1rem;
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const tapForSoundBtn = document.getElementById('tapForSoundBtn');
  const videoContainer = document.getElementById('videoContainer');
  const pinCloseBtn = document.getElementById('pinCloseBtn');

  if (heroVideo && tapForSoundBtn) {
    tapForSoundBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      heroVideo.muted = false;
      heroVideo.loop = false;
      heroVideo.controls = true;
      heroVideo.currentTime = 0;
      heroVideo.play();
      tapForSoundBtn.remove();
    });
  }

  if (videoContainer) {
    let dismissed = false;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (dismissed) return;
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          videoContainer.classList.add('is-pinned');
        } else if (entry.isIntersecting) {
          videoContainer.classList.remove('is-pinned');
        }
      },
      { threshold: 0 }
    );
    observer.observe(videoContainer);

    videoContainer.addEventListener('click', (e) => {
      if (!videoContainer.classList.contains('is-pinned')) return;
      if ((e.target as HTMLElement).closest('#pinCloseBtn')) return;
      videoContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    if (pinCloseBtn) {
      pinCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dismissed = true;
        videoContainer.classList.remove('is-pinned');
      });
    }
  }
</script>
