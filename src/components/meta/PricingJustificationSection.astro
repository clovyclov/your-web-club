    padding: 4.5rem 0 5rem 0;
  }

  .justification-card {
    max-width: 720px;
    width: 100%;
  }

  .justification-heading {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .justification-text {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .justification-punchline {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--neon-green);
    letter-spacing: -0.005em;
  }

  @media (max-width: 640px) {
    .justification-heading {
      font-size: 1.5rem;
    }
    .justification-text {
      font-size: 0.95rem;
