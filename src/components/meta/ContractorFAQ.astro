---
const faqs = [
  {
    q: "How does the 14-day money-back guarantee work?",
    a: "Sign up and we get to work launching your ads, website, and SMS automations. If you're not happy with the results in your first 14 days, just let us know and we'll refund you in full — no contracts, no hoops to jump through."
  },
  {
    q: "Are these leads shared with 5 other contractors like Angi or HomeAdvisor?",
    a: "No! Never. 100% of leads generated by your Contractor Growth System™ belong exclusively to your company. They land directly on your phone and email."
  },
  {
    q: "Why is it only $297/month with ZERO upfront setup fee?",
    a: "Traditional web agencies charge $5,000 upfront because they know their sites don't generate leads and you'll leave in 3 months. We align our success with yours. By charging $297/mo and guaranteeing results, we earn your business long-term."
  },
  {
    q: "What if I'm not happy after signing up?",
    a: "You get a full refund. There's no risk in trying — if it's not the right fit within your first 14 days, we'll cancel and refund you, no questions asked."
  },
  {
    q: "How fast can my system be live?",
    a: "Once you lock in your territory on our strategy call, your full system (custom site, ads setup, and SMS booking bot) is launched and live in as little as 7 to 10 business days."
  }
];
---

<section class="section faq-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">FREQUENTLY ASKED QUESTIONS</h2>
      <p class="section-subtitle">Everything you need to know about the 14-Day Money-Back Guarantee.</p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 5.5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-white);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: #cbd5e1;
    margin-top: 0.5rem;
  }

  .faq-list {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #181b20;
    border: none;
    border-radius: 0;
    overflow: hidden;
    transition: background 0.2s;
  }

  .faq-item[open] {
    background: #20242b;
  }

  .faq-question {
    padding: 1.5rem 1.75rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-white);
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    width: 20px;
    height: 20px;
    stroke: var(--neon-green);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.75rem 1.5rem 1.75rem;
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.65;
  }
</style>
