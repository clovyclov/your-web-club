---
export interface Message {
  text: string;
  sender?: 'user' | 'bot';
  type?: 'system';
  delay: number;
}

export interface Tab {
  id: string;
  label: string;
  /** Inner SVG markup (children of a 24x24 stroke icon), no outer <svg> tag */
  icon: string;
}

export interface HeaderConfig {
  name: string;
  avatarClass: string;
  /** Text or raw HTML (e.g. an SVG icon) shown in the avatar bubble */
  avatarContent: string;
}

export interface Props {
  tabs?: Tab[];
  sequences?: Record<string, Message[]>;
  headerConfig?: Record<string, HeaderConfig>;
}

const defaultTabs: Tab[] = [
  {
    id: 'booking',
    label: 'Booking Bot',
    icon: `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>`,
  },
  {
    id: 'reviews',
    label: 'Review Engine',
    icon: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>`,
  },
  {
    id: 'reactivation',
    label: 'Client Revival',
    icon: `<polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>`,
  },
];

const defaultSequences: Record<string, Message[]> = {
  booking: [
    { text: 'Hey, any openings this Friday?', sender: 'user', delay: 1000 },
    { text: 'Hey! 👋 Yes, 2:00 PM and 4:30 PM are open with Mike. Want one?', sender: 'bot', delay: 2500 },
    { text: '4:30 works.', sender: 'user', delay: 4000 },
    { text: 'Great. Secure it with a deposit here: secure-book.com/pay', sender: 'bot', delay: 5500 },
    { text: 'Done.', sender: 'user', delay: 7500 },
    { text: 'Confirmed! ✅ See you Friday at 4:30 PM.', sender: 'bot', delay: 8500 },
  ],
  reviews: [
    { text: 'Thanks for choosing us today! How was your service?', sender: 'bot', delay: 1000 },
    { text: 'Fire as always 🔥', sender: 'user', delay: 3000 },
    { text: 'Glad to hear it! Mind dropping a quick 5-star rating? It helps us a ton: google.com/review', sender: 'bot', delay: 4500 },
    { text: 'For sure, doing it now.', sender: 'user', delay: 6500 },
    { type: 'system', text: '⭐ New 5-Star Google Review Detected', delay: 8000 },
  ],
  reactivation: [
    { type: 'system', text: "⚠️ Alert: Client 'Mike' inactive for 35 days.", delay: 500 },
    { text: "Yo Mike, it's been about 5 weeks. Ready for your next visit? 🛠️", sender: 'bot', delay: 2000 },
    { text: 'Yeah I definitely need to get that scheduled.', sender: 'user', delay: 4000 },
    { text: 'Awesome, grab a slot here before the schedule fills up: [Link]', sender: 'bot', delay: 6000 },
    { text: 'Booked.', sender: 'user', delay: 8000 },
  ],
};

const defaultHeaderConfig: Record<string, HeaderConfig> = {
  booking: { name: 'Booking Assistant', avatarClass: 'booking', avatarContent: 'BS' },
  reviews: {
    name: 'Review Automation',
    avatarClass: 'reviews',
    avatarContent:
      '<svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 24 24" stroke="white" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>',
  },
  reactivation: {
    name: 'Retention AI',
    avatarClass: 'reactivation',
    avatarContent:
      '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>',
  },
};

const {
  tabs = defaultTabs,
  sequences = defaultSequences,
  headerConfig = defaultHeaderConfig,
} = Astro.props;

const instanceId = `sim-${Math.random().toString(36).slice(2, 9)}`;
const initialTabId = tabs[0]?.id ?? 'booking';
const initialHeader = headerConfig[initialTabId];
---

<div class="simulator-container" data-simulator-id={instanceId}>
  <!-- Tab Buttons -->
  <div class="tab-container">
    {tabs.map((tab, i) => (
      <button class={`tab-btn ${i === 0 ? 'active' : ''}`} data-tab={tab.id}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={tab.icon} />
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Phone Frame -->
  <div class="phone-frame">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <div class="chat-header">
        <div class={`chat-avatar ${initialHeader?.avatarClass ?? ''}`} set:html={initialHeader?.avatarContent ?? ''} />
        <div class="chat-info">
          <div class="chat-name">{initialHeader?.name}</div>
          <div class="chat-status">Active Now</div>
        </div>
      </div>
      <div class="chat-messages"></div>
    </div>
  </div>
</div>

<style>
  .simulator-container {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Tab Buttons */
  .tab-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 32px;
    background: white;
    padding: 6px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border: 1px solid #f1f5f9;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    background: transparent;
    color: #64748b;
  }

  .tab-btn:hover {
    background: #f1f5f9;
  }

  .tab-btn.active {
    background: #1e293b;
    color: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
  }

  .tab-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Phone Frame */
  .phone-frame {
    width: 300px;
    height: 580px;
    max-width: 100%;
    background: #1e293b;
    border-radius: 3rem;
    border: 8px solid #1e293b;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }

  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 128px;
    height: 24px;
    background: #1e293b;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    z-index: 20;
  }

  .phone-screen {
    background: #f8fafc;
    width: 100%;
    height: 100%;
    padding: 48px 12px 16px 12px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-sizing: border-box;
  }

  /* Chat Header */
  .chat-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 8px;
  }

  .chat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 10px;
    flex-shrink: 0;
  }

  .chat-avatar.booking { background: #f59e0b; }
  .chat-avatar.reviews { background: #22c55e; }
  .chat-avatar.reactivation { background: #ef4444; }

  .chat-avatar :global(svg) {
    width: 14px;
    height: 14px;
  }

  .chat-info {
    display: flex;
    flex-direction: column;
  }

  .chat-name {
    font-weight: 700;
    color: #1e293b;
    font-size: 12px;
  }

  .chat-status {
    font-size: 10px;
    color: #22c55e;
    font-weight: 500;
  }

  /* Messages */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-messages :global(.message) {
    max-width: 85%;
    padding: 12px 14px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    opacity: 0;
    animation: fadeInUp 0.4s ease-out forwards;
    word-wrap: break-word;
  }

  .chat-messages :global(.message.user) {
    background: #3b82f6;
    color: white;
    border-radius: 16px 16px 4px 16px;
    align-self: flex-end;
  }

  .chat-messages :global(.message.bot) {
    background: white;
    border: 1px solid #e2e8f0;
    color: #374151;
    border-radius: 16px 16px 16px 4px;
    align-self: flex-start;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* System Alert */
  .chat-messages :global(.system-alert) {
    display: flex;
    justify-content: center;
    margin: 8px 0;
    opacity: 0;
    animation: fadeInUp 0.4s ease-out forwards;
  }

  .chat-messages :global(.system-alert-inner) {
    background: #e2e8f0;
    color: #475569;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script define:vars={{ instanceId, sequences, headerConfig, initialTabId }}>
  (function () {
    const root = document.querySelector(`[data-simulator-id="${instanceId}"]`);
    if (!root) return;

    const chatMessages = root.querySelector('.chat-messages');
    const chatAvatar = root.querySelector('.chat-avatar');
    const chatName = root.querySelector('.chat-name');
    const tabBtns = root.querySelectorAll('.tab-btn');

    if (!chatMessages || !chatAvatar || !chatName) return;

    let currentTimeouts = [];

    function runSequence(tab) {
      currentTimeouts.forEach((t) => clearTimeout(t));
      currentTimeouts = [];

      chatMessages.innerHTML = '';

      const config = headerConfig[tab] || headerConfig[initialTabId];
      chatName.textContent = config.name;
      chatAvatar.className = 'chat-avatar ' + config.avatarClass;
      chatAvatar.innerHTML = config.avatarContent;

      const seq = sequences[tab] || sequences[initialTabId];

      seq.forEach((msg) => {
        const timeout = window.setTimeout(() => {
          if (msg.type === 'system') {
            const alertEl = document.createElement('div');
            alertEl.className = 'system-alert';
            alertEl.innerHTML = `<div class="system-alert-inner">${msg.text}</div>`;
            chatMessages.appendChild(alertEl);
          } else {
            const messageEl = document.createElement('div');
            messageEl.className = `message ${msg.sender}`;
            messageEl.textContent = msg.text;
            chatMessages.appendChild(messageEl);
          }
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }, msg.delay);

        currentTimeouts.push(timeout);
      });
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        tabBtns.forEach((b) => b.classList.remove('active'));
        this.classList.add('active');
        const tab = this.dataset.tab;
        if (tab) runSequence(tab);
      });
    });

    setTimeout(() => runSequence(initialTabId), 500);
  })();
</script>
