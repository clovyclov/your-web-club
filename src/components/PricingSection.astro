---
---

<section class="section pricing-section" id="pricing">
  <div class="container">
    <div class="pricing-header">
      <h2 class="pricing-title">
        2 Options to help you <span class="highlight">DOMINATE</span>
      </h2>
    </div>

    <div class="grid-2 pricing-grid">
      <!-- Plan 1: Your Web Club CRM -->
      <div class="pricing-card">
        <div class="card-header">
          <h3 class="plan-name">Your Web Club CRM</h3>
          <p class="plan-subtitle">Perfect for Growth</p>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">197</span>
            <span class="period">/Month</span>
          </div>
        </div>

        <div class="card-body">
          <p class="feature-heading">You Get:</p>
          <ul class="feature-list">
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Live AI Webchat</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Review Accelerator</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Missed Call Text Back</span>
            </li>
          </ul>
        </div>

        <div class="card-footer">
          <a href="#" data-open-lead-modal class="btn btn-dark w-full">Get Started</a>
        </div>
      </div>

      <!-- Plan 2: System + Website (Featured) -->
      <div class="pricing-card featured">
        <div class="featured-badge">Most popular</div>
        <div class="card-header">
          <h3 class="plan-name">System + Website</h3>
          <p class="plan-subtitle">Perfect for Maximum Growth</p>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">297</span>
            <span class="period">/Month</span>
            <div class="setup-fee">+$5,000 Setup</div>
          </div>
        </div>

        <div class="card-body">
          <div class="conversion-built-banner">
            <span class="tag font-italic">Conversion Built</span>
            <h4 class="banner-title">YWC Website</h4>
          </div>

          <p class="feature-heading">You Get:</p>
          <ul class="feature-list">
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Live AI Webchat</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>2-Way SMS</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Missed Call Text Back</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Marketing CRM</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Review Management</span>
            </li>
          </ul>
        </div>

        <div class="card-footer">
          <a href="#" data-open-lead-modal class="btn btn-neon w-full">Get Started</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 6rem 0;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .pricing-title {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-white);
    letter-spacing: -0.02em;
  }

  .pricing-title .highlight {
    color: var(--neon-green);
  }

  .pricing-grid {
    max-width: 960px;
    margin: 0 auto;
    gap: 2.5rem;
  }

  .pricing-card {
    background: #262626;
    border: none;
    border-radius: 0;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.25s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
  }

  .pricing-card.featured {
    border: 2px solid var(--neon-green);
    background: #2a2a2a;
  }

  .featured-badge {
    position: absolute;
    top: -15px;
    right: 25px;
    background: var(--neon-green);
    color: #000000;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 1rem;
    border-radius: 0;
    letter-spacing: 0.05em;
  }

  .card-header {
    margin-bottom: 2rem;
  }

  .plan-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-white);
    margin-bottom: 0.25rem;
  }

  .plan-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .currency {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--neon-green);
  }

  .amount {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--text-white);
    line-height: 1;
  }

  .period {
    font-size: 1.1rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .setup-fee {
    font-size: 1rem;
    color: #cbd5e1;
    font-style: italic;
    margin-left: 0.5rem;
    font-weight: 600;
  }

  .card-body {
    flex: 1;
    margin-bottom: 2.5rem;
  }

  .conversion-built-banner {
    background: rgba(112, 224, 0, 0.1);
    border: 1px dashed var(--neon-green);
    border-radius: 0;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--neon-green);
    font-weight: 700;
  }

  .banner-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-white);
  }

  .feature-heading {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-white);
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: #e2e8f0;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    stroke: var(--neon-green);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .pricing-title {
      font-size: 1.85rem;
    }
  }
</style>
