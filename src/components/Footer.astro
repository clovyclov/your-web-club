---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <a href="/" class="footer-logo-link">
        <img 
          src="/logos/ywc-logo.png"
          alt="Your Web Club Logo" 
          class="footer-logo"
        />
      </a>

      <div class="footer-nav">
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#resources">Resources</a>
        <a href="#book-a-call">Strategy Call</a>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {new Date().getFullYear()} Your Web Club. All rights reserved.</p>
      <div class="legal-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #08090a;
    border-top: 1px solid var(--border-dark);
    padding: 4rem 0 2.5rem 0;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-logo {
    height: 38px;
    width: auto;
  }

  .footer-nav {
    display: flex;
    gap: 2rem;
  }

  .footer-nav a {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--neon-green);
  }

  .footer-divider {
    height: 1px;
    background: var(--border-dark);
    width: 100%;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .legal-links a {
    color: #64748b;
    transition: color 0.2s;
  }

  .legal-links a:hover {
    color: var(--text-white);
  }

  @media (max-width: 640px) {
    .footer-top, .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
