---
const cards = [
  {
    title: "Turn One-Time Customers Into Lifelong Clients",
    text: "Repeat customers are the backbone of a thriving business. Our system keeps you top of mind with automated follow-ups and exclusive offers, so they keep coming back instead of going to your competitors."
  },
  {
    title: "Free Up Hours Every Week & Focus on What Matters",
    text: "You are too busy running your business to waste time chasing leads and returning calls. Our system automates the entire process, so you get more done in less time and can focus on what really moves the needle."
  },
  {
    title: "Get More 5-Star Reviews & Dominate Your Market",
    text: "Your best customers want to rave about you—they just need a little nudge. Our system follows up automatically, making it effortless for them to leave glowing reviews that bring in more business."
  },
  {
    title: "Turn More Leads Into Paying Customers",
    text: "Not every lead books right away, but that does not mean they are lost. Our system keeps them engaged with automated follow-ups until they are ready to buy, ensuring you close more deals with less effort."
  }
];
---

<section class="green-section">
  <div class="container">
    <div class="green-header">
      <h2 class="green-title">
        STOP GIVING CUSTOMERS TO YOUR <span>COMPETITORS</span>
      </h2>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid-4 green-cards-grid">
      {cards.map((card) => (
        <div class="green-card">
          <h3 class="green-card-title">{card.title}</h3>
          <p class="green-card-text">{card.text}</p>
        </div>
      ))}
    </div>

    <!-- Detroit Jiu-Jitsu Testimonial Card -->
    <div class="green-testimonial">
      <div class="djj-testimonial-card">
        <div class="djj-avatar-wrapper">
          <img 
            src="https://yourwebclub.com/wp-content/uploads/2025/01/djjlogo.png" 
            alt="Detroit Jiu-Jitsu Logo" 
            class="djj-logo"
          />
        </div>
        <blockquote class="djj-quote">
          The new system added over <strong>$14k/mo</strong> to our business. People ask less questions are and ready to buy. And it's all automated so I don't even have to think about it
        </blockquote>
        <div class="djj-author">Danny Agemy</div>
        <div class="djj-company">Detroit Jiu-Jitsu</div>
      </div>
    </div>
  </div>
</section>

<style>
  .green-section {
    background-color: #70e000;
    color: var(--text-dark);
    padding: 6rem 0;
    position: relative;
  }

  .green-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .green-title {
    font-family: var(--font-heading);
    font-size: 2.85rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #000000;
    letter-spacing: -0.02em;
    max-width: 850px;
    margin: 0 auto;
    line-height: 1.25;
  }

  .green-title span {
    text-decoration: underline;
    text-decoration-thickness: 5px;
  }

  .green-cards-grid {
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .green-card {
    background: #70e000;
    border: 1.5px solid #000000;
    border-radius: 14px;
    box-shadow: 4px 4px 0px #000000;
    padding: 2.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .green-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px #000000;
  }

  .green-card-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #000000;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .green-card-text {
    font-size: 0.9rem;
    color: #0f172a;
    line-height: 1.6;
    font-weight: 500;
    text-align: center;
  }

  /* Testimonial Box inside Green Section */
  .green-testimonial {
    display: flex;
    justify-content: center;
  }

  .djj-testimonial-card {
    background: #70e000;
    border: 1.5px solid #000000;
    border-radius: 18px;
    box-shadow: 4px 4px 0px #000000;
    padding: 3.25rem 2.5rem;
    max-width: 880px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
  }

  .djj-avatar-wrapper {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    overflow: hidden;
    border: 2.5px solid #000000;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .djj-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .djj-quote {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: #000000;
    line-height: 1.45;
    max-width: 720px;
    margin: 0;
    text-align: center;
  }

  .djj-quote strong {
    font-weight: 900;
    text-decoration: underline;
  }

  .djj-author {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: #000000;
    text-align: center;
  }

  .djj-company {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1e293b;
    text-align: center;
  }

  @media (max-width: 768px) {
    .green-title {
      font-size: 1.85rem;
    }
    .djj-quote {
      font-size: 1.1rem;
    }
  }
</style>
