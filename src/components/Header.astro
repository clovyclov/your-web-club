---

<header class="header">
  <div class="header-container container">
    <!-- Brand Logo -->
    <a href="/" class="logo-link">
      <img 
        src="https://yourwebclub.com/wp-content/uploads/2024/12/ywc-logo.png" 
        alt="Your Web Club logo" 
        class="logo-img"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-menu">
      <div class="nav-item dropdown">
        <button class="nav-link dropdown-toggle" id="servicesDropdownBtn" aria-expanded="false">
          Services
          <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu Floater -->
        <div class="dropdown-menu" id="servicesDropdown">
          <div class="dropdown-content grid-2">
            <div class="dropdown-column">
              <span class="dropdown-heading">Core Services</span>
              <ul class="dropdown-list">
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div>
                      <div class="item-title">Google & Meta Ads</div>
                      <div class="item-desc">Target high-intent homeowners ready to buy</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </div>
                    <div>
                      <div class="item-title">High-Converting Sites</div>
                      <div class="item-desc">Proven website frameworks built for sales</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div>
                      <div class="item-title">AI SMS & Booking Bot</div>
                      <div class="item-desc">Automated 24/7 lead conversion & scheduling</div>
                    </div>
                  </a>
                </li>
              </ul>
            </div>

            <div class="dropdown-column">
              <span class="dropdown-heading">Automations</span>
              <ul class="dropdown-list">
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </div>
                    <div>
                      <div class="item-title">Review Accelerator</div>
                      <div class="item-desc">Automated 5-star Google review collection</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div>
                      <div class="item-title">Missed Call Text-Back</div>
                      <div class="item-desc">Instant text response when missed calls happen</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="#services" class="dropdown-item">
                    <div class="icon-wrap">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#70e000" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    </div>
                    <div>
                      <div class="item-title">Client Revival Engine</div>
                      <div class="item-desc">Turn past leads into repeat sales automatically</div>
                    </div>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#book-a-call" class="btn btn-neon btn-sm">Schedule A Strategy Call</a>
      
      <!-- Mobile Toggle -->
      <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Offcanvas Menu -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="drawer-header">
      <img src="https://yourwebclub.com/wp-content/uploads/2024/12/ywc-logo.png" alt="Logo" class="drawer-logo" />
      <button class="drawer-close" id="drawerCloseBtn">&times;</button>
    </div>
    <div class="drawer-body">
      <a href="#services" class="drawer-link">Services</a>
      <div class="drawer-actions">
        <a href="#book-a-call" class="btn btn-neon w-full">Schedule A Strategy Call</a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 11, 13, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-dark);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  .logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: #e2e8f0;
    transition: color 0.2s;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link:hover {
    color: var(--neon-green);
  }

  /* Dropdown styling */
  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: -20px;
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;
    z-index: 110;
  }

  .dropdown:hover .dropdown-menu,
  .dropdown.active .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-content {
    background: #121418;
    border: 1px solid var(--border-dark);
    border-radius: 18px;
    padding: 1.5rem;
    width: 600px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .dropdown-heading {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: block;
  }

  .dropdown-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .icon-wrap {
    background: rgba(112, 224, 0, 0.1);
    padding: 0.4rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .item-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .item-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.65rem 1.35rem;
    font-size: 0.8rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
  }

  .mobile-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: 0.3s;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: 300px;
    height: 100vh;
    background: #0d0e12;
    z-index: 200;
    padding: 2rem 1.5rem;
    transition: left 0.3s ease;
    box-shadow: 10px 0 30px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer.open {
    left: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .drawer-logo {
    height: 32px;
  }

  .drawer-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }

  .drawer-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .drawer-link {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
  }

  .drawer-actions {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 900px) {
    .nav-menu, .header-review-btn {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const drawerCloseBtn = document.getElementById('drawerCloseBtn');

  if (mobileMenuBtn && mobileDrawer && drawerCloseBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileDrawer.classList.add('open');
    });

    drawerCloseBtn.addEventListener('click', () => {
      mobileDrawer.classList.remove('open');
    });
  }

  const dropdownBtn = document.getElementById('servicesDropdownBtn');
  const dropdownParent = dropdownBtn?.closest('.dropdown');

  if (dropdownBtn && dropdownParent) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdownParent.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      if (!dropdownParent.contains(e.target as Node)) {
        dropdownParent.classList.remove('active');
      }
    });
  }
</script>
