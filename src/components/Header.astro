---
---

<header class="header">
  <div class="header-container container">
    <!-- Brand Logo -->
    <img
      src="/logos/ywc-logo.png"
      alt="Your Web Club logo"
      class="logo-img"
    />

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#" data-open-lead-modal class="btn btn-neon btn-sm">Schedule A Strategy Call</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 11, 13, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-dark);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  .logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.65rem 1.35rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .header-container {
      flex-direction: column;
      justify-content: center;
      height: auto;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
      gap: 0.65rem;
    }
    .logo-img {
      height: 26px;
    }
    .btn-sm {
      font-size: 0.75rem;
      padding: 0.6rem 1.25rem;
    }
  }
</style>
