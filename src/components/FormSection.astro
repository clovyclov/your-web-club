---

<section class="section form-section" id="book-a-call">
  <div class="container flex-column align-center">
    <div class="form-wrapper">
      <h2 class="form-title">LET'S GET YOUR SYSTEM STARTED</h2>
      
      <form class="lead-form" id="leadForm">
        <div class="form-group">
          <label for="fullName">Full name</label>
          <input type="text" id="fullName" placeholder="Enter your full name" required />
        </div>

        <div class="form-group">
          <label for="businessName">Business name</label>
          <input type="text" id="businessName" placeholder="Enter your business name" required />
        </div>

        <div class="form-group">
          <label for="phone">Phone *</label>
          <input type="tel" id="phone" placeholder="+1 (555) 000-0000" required />
        </div>

        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" placeholder="john@company.com" required />
        </div>

        <div class="hp-field" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-blue btn-submit">Submit</button>
      </form>
    </div>
  </div>
</section>

<style>
  .form-section {
    padding: 6.5rem 0;
  }

  .form-wrapper {
    background: #ffffff;
    border-radius: 20px;
    padding: 3.25rem 3rem;
    max-width: 580px;
    width: 100%;
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.6);
    color: #1e293b;
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    color: #0f172a;
    margin-bottom: 2.25rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #334155;
  }

  .form-group input {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .btn-submit {
    margin-top: 1rem;
    font-size: 0.95rem;
    padding: 0.95rem;
    letter-spacing: 0.04em;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .form-wrapper {
      padding: 2rem 1.5rem;
    }
    .form-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  import { submitLead } from '../lib/submitLead';

  const form = document.getElementById('leadForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitLead(
      {
        fullName: (document.getElementById('fullName') as HTMLInputElement).value,
        businessName: (document.getElementById('businessName') as HTMLInputElement).value,
        phone: (document.getElementById('phone') as HTMLInputElement).value,
        email: (document.getElementById('email') as HTMLInputElement).value,
        website: (document.getElementById('website') as HTMLInputElement).value,
      },
      '/checkout'
    );
  });
</script>
