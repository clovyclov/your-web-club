---
---

<section class="section got-yard-section">
  <div class="container flex-column align-center">
    <div class="testimonial-box">
      <img 
        src="https://yourwebclub.com/wp-content/uploads/2026/03/got-yard-light.png" 
        alt="Got Yard Landscape" 
        class="gotyard-logo"
      />

      <blockquote class="quote-text">
        “We sold $20k and a $17k project almost immediately. It is working great.”
      </blockquote>

      <div class="author-info">
        <div class="author-name">Rylan</div>
        <div class="author-title">Got Yard Landscape</div>
      </div>
    </div>
  </div>
</section>

<style>
  .got-yard-section {
    padding: 3rem 0 5.5rem 0;
  }

  .testimonial-box {
    background: #262626;
    border: none;
    border-radius: 0;
    padding: 3.75rem 2.5rem;
    max-width: 920px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .gotyard-logo {
    max-height: 60px;
    width: auto;
  }

  .quote-text {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--neon-green);
    line-height: 1.4;
    max-width: 780px;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .author-title {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .quote-text {
      font-size: 1.25rem;
    }
  }
</style>
