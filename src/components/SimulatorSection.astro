---
import PhoneChatSimulator from './PhoneChatSimulator.astro';
---

<section class="section simulator-section">
  <div class="container flex-column align-center">
    <h2 class="simulator-heading">
      A System That Works While You Sleep
    </h2>

    <PhoneChatSimulator />
  </div>
</section>

<style>
  .simulator-section {
    padding: 5.5rem 0;
  }

  .simulator-heading {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-white);
    margin-bottom: 2.75rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 768px) {
    .simulator-heading {
      font-size: 1.75rem;
    }
  }
</style>
