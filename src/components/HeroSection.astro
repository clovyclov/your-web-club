---
const logos = [
  { src: "/logos/djjlogo.png", alt: "DJJ Logo" },
  { src: "/logos/CottageInnLogoOvalsmall-1.png", alt: "Cottage Inn Logo" },
  { src: "/logos/ipglogo-1.png", alt: "IPG Logo" },
  { src: "/logos/saberLogo-125-1.png", alt: "Saber Logo" },
  { src: "/logos/Ford-Motor-Company-Logo-1.png", alt: "Ford Motor Company Logo" },
  { src: "/logos/logo-1.png", alt: "Partner Logo" },
  { src: "/logos/skinsational-dark-1.png", alt: "Skinsational Logo" },
  { src: "/logos/bw-color-logo.png", alt: "BW Logo" },
  { src: "/logos/kosher-white.png", alt: "Kosher Logo" },
  { src: "/logos/gotyard-white.png", alt: "Got Yard Logo" },
];
---

<section class="hero-section section">
  <div class="container hero-container">
    <!-- Hero Heading & Intro -->
    <div class="hero-header">
      <h1 class="hero-title">
        Helping Contractors Book High-Quality Homeowner Jobs
      </h1>
      <p class="hero-subtitle">
        Results-driven <strong>Google and Meta</strong> ads made to get you in front of people actually ready to pay for your service.
      </p>
      <div class="hero-cta-wrapper">
        <a href="#" data-open-lead-modal class="btn btn-neon btn-lg">Schedule A Strategy Call</a>
      </div>
    </div>

    <!-- Trusted Logos Marquee -->
    <div class="marquee-wrapper">
      <p class="marquee-label">Trusted by Contractors</p>
      <div class="marquee-container">
        <div class="marquee-content">
          {logos.concat(logos).map((logo) => (
            <div class="logo-item">
              <img src={logo.src} alt={logo.alt} loading="lazy" class="logo-img" />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Hero Testimonial Card -->
    <div class="hero-testimonial">
      <div class="testimonial-card">
        <img 
          src="/logos/dn-logo.jpg"
          alt="Dumpsters Now" 
          class="dn-logo"
        />
        <h2 class="testimonial-title">
          "WE GOT A 12X ROI ON OUR GOOGLE ADS, IT'S BEEN INSANE"
        </h2>
        <p class="testimonial-author">Dumpsters Now, LLC</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  .hero-header {
    max-width: 950px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 2.85rem;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--text-white);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #cbd5e1;
    max-width: 760px;
    font-weight: 400;
    line-height: 1.6;
  }

  .hero-subtitle strong {
    color: var(--text-white);
    font-weight: 700;
  }

  .btn-lg {
    padding: 1.15rem 2.75rem;
    font-size: 1rem;
    letter-spacing: 0.03em;
  }

  /* Marquee Styling */
  .marquee-wrapper {
    width: 100%;
    max-width: 1080px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .marquee-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    padding: 0 1rem;
  }

  .logo-img {
    max-height: 42px;
    width: auto;
    object-fit: contain;
    filter: brightness(0.95) opacity(0.85);
    transition: filter 0.2s;
  }

  .logo-img:hover {
    filter: brightness(1) opacity(1);
  }

  /* Testimonial Banner */
  .hero-testimonial {
    width: 100%;
    max-width: 820px;
    margin-top: 1rem;
  }

  .testimonial-card {
    background: #262626;
    border: none;
    border-radius: 0;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
  }

  .dn-logo {
    height: 54px;
    width: auto;
    border-radius: 0;
  }

  .testimonial-title {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-white);
    max-width: 680px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .testimonial-author {
    font-size: 1rem;
    color: #ea580c;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 1.85rem;
    }
    .hero-subtitle {
      font-size: 1.05rem;
    }
    .testimonial-title {
      font-size: 1.25rem;
    }
  }
</style>
